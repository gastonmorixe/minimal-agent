{
  "name": "minimal-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Umbrella monorepo: git submodules for minimal-agent-core, minimal-agent-plugins, minimal-agent-cli, and minimal-agent-web.",
  "homepage": "https://github.com/gastonmorixe/minimal-agent",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gastonmorixe/minimal-agent.git"
  },
  "type": "module",
  "workspaces": [
    "minimal-agent-*",
    "minimal-agent-*/tools/*",
    "minimal-agent-*/ma-*-plugin",
    "minimal-agent-*/ma-*-kit",
    "minimal-agent-*/*"
  ],
  "overrides": {
    "@minimal-agent/core": "workspace:*",
    "@types/node": "^26"
  },
  "catalog": {
    "@biomejs/biome": "2.6.6",
    "bun-types": "^1.4.4",
    "eslint-plugin-jsdoc": "^65.4.5",
    "eslint-plugin-tsdoc": "^0.5.4",
    "oxlint": "1.92.0",
    "oxlint-tsgolint": "7.0.2006",
    "typescript": "7.0.2"
  },
  "scripts": {
    "install:all": "bun install && bun install --cwd minimal-agent-core && bun install --cwd minimal-agent-plugins && bun install --cwd minimal-agent-cli && bun install --cwd minimal-agent-web",
    "start": "bun run --cwd minimal-agent-cli start",
    "cli:compile:dev": "bun run --cwd minimal-agent-cli compile:dev",
    "cli:compile:release": "bun run --cwd minimal-agent-cli compile:release",
    "test": "bun run --cwd minimal-agent-core test && bun run --cwd minimal-agent-plugins test && bun run --cwd minimal-agent-cli test && bun run --cwd minimal-agent-web test",
    "test:plugins": "bun run --cwd minimal-agent-plugins test:plugins",
    "test:e2e:opencode-go": "bash scripts/test-e2e-opencode-go.sh",
    "test:e2e:opencode-go:plugin": "bash scripts/test-e2e-opencode-go.sh plugin",
    "test:e2e:opencode-go:cli": "bash scripts/test-e2e-opencode-go.sh cli",
    "check": "bun run scripts/check-core-pins.ts --report-only && bun run --cwd minimal-agent-core check && bun run --cwd minimal-agent-plugins check && bun run --cwd minimal-agent-cli check && bun run --cwd minimal-agent-web check",
    "typecheck": "bun run --cwd minimal-agent-core typecheck && bun run --cwd minimal-agent-plugins typecheck && bun run --cwd minimal-agent-cli typecheck && bun run --cwd minimal-agent-web typecheck",
    "link:dev": "bun run scripts/link-dev.ts link",
    "link:reset": "bun run scripts/link-dev.ts reset",
    "link:status": "bun run scripts/link-dev.ts status",
    "pins:mains": "bun run scripts/pin-mains.ts",
    "pins:check": "bun run scripts/check-core-pins.ts",
    "submodules:status": "git submodule status",
    "submodules:update": "git submodule update --remote --merge",
    "submodules:init": "git submodule update --init --recursive",
    "version": "bun run scripts/version.ts",
    "version:status": "bun run scripts/version.ts status",
    "commitlint": "commitlint",
    "commitlint:last": "commitlint --last --verbose",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "bun-types": "^1.3.14",
    "husky": "^9.1.7",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.4.4"
  }
}
